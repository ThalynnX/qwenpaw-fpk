#!/bin/bash

### 升级回调：保留现有运行环境（venv/数据），仅刷新源码并修正权限。
### 升级时 install_callback 检测到保留标记会跳过重装。

WORKING_DIR="${TRIM_PKGHOME}"
VENV_DIR="${WORKING_DIR}/venv"
CODE_DIR="${TRIM_APPDEST}/qwenpaw/code"
LOG_FILE="${TRIM_PKGVAR}/qwenpaw-upgrade.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}" 2>/dev/null || true
}

touch "${WORKING_DIR}/.qwenpaw_keep_runtime"

# 权限修正
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${WORKING_DIR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGETC}" 2>/dev/null || true
chmod -R 755 "${WORKING_DIR}" 2>/dev/null || true
chmod -R 755 "${TRIM_PKGVAR}" 2>/dev/null || true
chmod -R 755 "${TRIM_PKGETC}" 2>/dev/null || true

log_msg "升级回调完成（保留运行环境，新源码已就位）"
exit 0
